# Copy to .env (never commit it). Without any of this the Copilot uses the rule engine only.
# FA_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# FA_LLM_MODEL=claude-sonnet-5-5
#
# FA_LLM_PROVIDER=openai
# FA_LLM_API_KEY=
# FA_LLM_MODEL=
# FA_LLM_BASE_URL=https://api.openai.com/v1
#
# Local, works without internet (Ollama):
# FA_LLM_PROVIDER=ollama
# FA_LLM_MODEL=
# FA_LLM_VISION=0

# Voice that works in every browser and in Arabic (Azure AI Speech). Without it the app uses the browser's own speech (Chrome or Edge).
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
